{
  "skill": "pg-inspect",
  "prompt": "you@laptop:~/shop",
  "steps": [
    {
      "cmd": "pg.py tables",
      "phase": "look first",
      "note": "what exists, how big \u2014 before writing a migration",
      "out": [
        "# tables in public",
        "table | approx_rows | size",
        "orders | 900 | 168 kB",
        "customers | 250 | 104 kB",
        "products | 120 | 48 kB"
      ]
    },
    {
      "cmd": "pg.py schema orders",
      "phase": "shape",
      "note": "columns, types and indexes in one call",
      "out": [
        "# schema public.orders",
        "column_name | data_type | is_nullable | default",
        "id | integer | NO | nextval('orders_id_seq'::regclass)",
        "customer_id | integer | YES |",
        "status | text | YES |"
      ]
    },
    {
      "cmd": "pg.py q \"select status, count(*) from orders group by 1\"",
      "phase": "read",
      "note": "the agent runs its own questions instead of guessing columns",
      "out": [
        "status | count",
        "paid | 225",
        "refunded | 225",
        "shipped | 225",
        "new | 225",
        "(4 rows)"
      ]
    },
    {
      "cmd": "pg.py q \"drop table orders\"",
      "phase": "the guarantee",
      "note": "and it cannot write, even if the model tries",
      "out": [
        "refused: only read statements (select, with, table, values, explain, show) are allowed"
      ]
    }
  ]
}
